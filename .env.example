# MortgageShield Environment Variables
# Copy to .env and fill in values

# Database
POSTGRES_PASSWORD=change_me_in_production

# API Security
SHIELDAPI_KEY=change_me_in_production

# AI
ANTHROPIC_API_KEY=sk-ant-...

# Australian Business Register (free — register at api.abn.business.gov.au)
ABN_API_GUID=your-guid-here

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:3004
LOGIN_PASSWORD=change_me_in_production
