# Trutina Environment Variables
# Copy to .env and fill in values

# Database
POSTGRES_PASSWORD=change_me_in_production

# API Security (REQUIRED — no default, must be set)
TRUTINA_API_KEY=change_me_in_production

# CORS allowed origins (comma-separated)
CORS_ORIGINS=https://trutina.vercel.app,https://trutina.com.au

# AI
ANTHROPIC_API_KEY=sk-ant-...

# Australian Business Register (free — register at api.abn.business.gov.au)
ABN_API_GUID=your-guid-here

# Frontend (Next.js — set in frontend/.env.local)
LOGIN_PASSWORD=change_me_in_production
